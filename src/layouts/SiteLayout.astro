---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	language?: string;
	direction?: 'ltr' | 'rtl';
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	image,
	language = 'en',
	direction = 'ltr',
} = Astro.props;
---

<!doctype html>
<html lang={language} dir={direction}>
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<a href="#main-content" class="sr-only z-50 focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:rounded-sm focus:bg-ink focus:px-5 focus:py-3 focus:text-white">Skip to content</a>
		<Header />
		<main id="main-content">
			<slot />
		</main>
		<Footer />
	</body>
</html>
