---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import CTA from '../../components/CTA.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featuredPost, ...remainingPosts] = posts;
---

<SiteLayout title="Insights | M. Dekel CPA" description="Practical accounting, tax, and financial perspectives from M. Dekel CPA.">
	<section class="bg-powder px-5 py-20 sm:px-8 lg:py-28">
		<div class="mx-auto max-w-5xl text-center">
			<p class="text-xs font-bold tracking-[0.26em] text-ink-soft uppercase">The journal</p>
			<h1 class="mt-6 font-display text-6xl leading-none text-balance text-ink sm:text-7xl">Useful perspective for the decisions ahead.</h1>
			<p class="mx-auto mt-8 max-w-2xl text-xl text-ink-soft">Clear explanations and practical ideas for your business and financial life.</p>
		</div>
	</section>

	<section class="px-5 py-24 sm:px-8 lg:py-32">
		<div class="mx-auto max-w-7xl">
			{featuredPost && <ArticleCard post={featuredPost} featured />}
			<div class="mt-20 grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
				{remainingPosts.map((post) => <ArticleCard post={post} />)}
			</div>
		</div>
	</section>

	<CTA eyebrow="Have a question?" title="A useful conversation can be the best place to start." />
</SiteLayout>
