---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { isLocale, postSlug, type Locale } from '../../../i18n/config';
export async function getStaticPaths() {
	const posts=await getCollection('blog');
	return posts.map((post)=>({params:{lang:post.data.locale,slug:postSlug(post.id)},props:post}));
}
type Props=CollectionEntry<'blog'>; const post=Astro.props; const locale=Astro.params.lang;
if(!isLocale(locale)||post.data.locale!==locale) return Astro.redirect('/he/blog/');
const {Content}=await render(post);
---
<BlogPost {...post.data} locale={locale as Locale}><Content/></BlogPost>
