---
import CTA from "../../components/CTA.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { LOCALES, isLocale } from "../../i18n/config";
import { m } from "../../paraglide/messages.js";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang;
if (!isLocale(locale)) return Astro.redirect("/he/");

const taxCalculators = [
  {
    title: m.calculator_income_tax(),
    description: m.calculator_income_tax_desc(),
    href: "https://www.gov.il/he/service/income-tax-calculator",
  },
  {
    title: m.calculator_tax_credit(),
    description: m.calculator_tax_credit_desc(),
    href: "https://www.gov.il/he/service/tax-credit",
  },
  {
    title: m.calculator_cash(),
    description: m.calculator_cash_desc(),
    href: "https://www.gov.il/he/service/reduced-useofcash-simulator",
  },
  {
    title: m.calculator_real_estate(),
    description: m.calculator_real_estate_desc(),
    href: "https://www.gov.il/he/service/real_estate_selfshuma",
  },
];

const insuranceCalculators = [
  {
    title: m.calculator_self_employed(),
    description: m.calculator_self_employed_desc(),
    href: "https://www.btl.gov.il/insurance/national%20insurance/type_list/self_employed/Pages/default.aspx",
  },
  {
    title: m.calculator_coordination(),
    description: m.calculator_coordination_desc(),
    href: "https://www.btl.gov.il/Simulators/BituahCalc/Pages/Teum_insurance.aspx",
  },
  {
    title: m.calculator_insurance_directory(),
    description: m.calculator_insurance_directory_desc(),
    href: "https://www.btl.gov.il/Simulators/Pages/default.aspx",
  },
];

const groups = [
  {
    title: m.calculators_tax_group(),
    authority: m.authority_tax(),
    calculators: taxCalculators,
  },
  {
    title: m.calculators_insurance_group(),
    authority: m.authority_insurance(),
    calculators: insuranceCalculators,
  },
];
---

<SiteLayout
  locale={locale}
  title={`${m.nav_calculators()} | Myri Dekel CPA`}
  description={m.calculators_meta()}
>
  <section class="bg-powder px-5 py-20 sm:px-8 lg:py-28">
    <div class="mx-auto max-w-5xl text-center">
      <p class="text-xs font-bold tracking-[0.26em] text-ink-soft uppercase">
        {m.calculators_eyebrow()}
      </p>
      <h1
        class="mt-6 font-display text-5xl leading-none text-balance sm:text-7xl"
      >
        {m.calculators_title()}
      </h1>
      <p class="mx-auto mt-8 max-w-3xl text-xl text-ink-soft">
        {m.calculators_intro()}
      </p>
      {
        locale !== "he" && (
          <p class="mx-auto mt-4 max-w-2xl text-sm text-ink-soft">
            {m.calculators_hebrew_notice()}
          </p>
        )
      }
    </div>
  </section>

  <section class="px-5 py-20 sm:px-8 lg:py-28">
    <div class="mx-auto max-w-7xl space-y-20">
      {
        groups.map((group) => (
          <div>
            <div class="border-b border-ink/15 pb-5">
              <h2 class="font-display text-4xl sm:text-5xl">{group.title}</h2>
            </div>
            <div class="mt-8 grid gap-6 md:grid-cols-2">
              {group.calculators.map((calculator) => (
                <article class="flex min-h-72 flex-col bg-cream p-7 shadow-card transition hover:-translate-y-1 hover:shadow-soft sm:p-9">
                  <p class="text-xs font-bold tracking-[0.18em] text-coral-dark uppercase">
                    {group.authority}
                  </p>
                  <h3 class="mt-4 font-display text-3xl leading-tight">
                    {calculator.title}
                  </h3>
                  <p class="mt-4 text-ink-soft">{calculator.description}</p>
                  <a
                    href={calculator.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-auto inline-flex items-center gap-2 pt-8 text-sm font-bold tracking-[0.12em] text-ink uppercase underline decoration-coral-dark decoration-2 underline-offset-4 transition hover:text-coral-dark"
                  >
                    <span>{m.calculators_open()}</span>
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      class="size-4 shrink-0"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                    >
                      <path d="M14 5h5v5M19 5l-9 9" />
                      <path d="M19 13v6H5V5h6" />
                    </svg>
                    <span class="sr-only">({m.calculators_external()})</span>
                  </a>
                </article>
              ))}
            </div>
          </div>
        ))
      }

      <aside class="border-s-4 border-coral-dark bg-powder-light p-7 sm:p-9">
        <h2 class="font-display text-2xl">
          {m.calculators_disclaimer_title()}
        </h2>
        <p class="mt-3 max-w-5xl text-ink-soft">
          {m.calculators_disclaimer()}
        </p>
      </aside>
    </div>
  </section>

  <CTA locale={locale} />
</SiteLayout>
