---
import { Image } from "astro:assets";
import founderPortrait from "../../assets/headshots/m-dekel-portrait.jpg";
import founderSeated from "../../assets/headshots/m-dekel-seated.jpg";
import CTA from "../../components/CTA.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { LOCALES, isLocale } from "../../i18n/config";
import { m } from "../../paraglide/messages.js";
export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang;
if (!isLocale(locale)) return Astro.redirect("/he/");
---

<SiteLayout
  locale={locale}
  title={`${m.nav_about()} | Myri Dekel CPA`}
  description={m.about_meta()}
>
  <section class="bg-cream px-5 py-20 sm:px-8 lg:py-28">
    <div
      class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-2 lg:gap-24"
    >
      <div>
        <p
          class="text-xs font-bold tracking-[0.26em] text-coral-dark uppercase"
        >
          {m.about_eyebrow()}
        </p><h1
          class="mt-6 font-display text-6xl leading-none text-balance sm:text-7xl"
        >
          {m.about_title()}
        </h1><p class="mt-8 max-w-xl text-xl text-ink-soft">
          {m.about_intro()}
        </p>
      </div><div class="relative mx-auto max-w-lg">
        <div class="absolute -end-8 -top-8 h-2/3 w-2/3 bg-powder"></div><Image
          src={founderPortrait}
          alt={m.founder_alt()}
          widths={[480, 720, 960]}
          sizes="(min-width:1024px) 40vw,80vw"
          class="relative aspect-[4/5] w-full object-cover shadow-soft"
        />
      </div>
    </div>
  </section>
  <section class="px-5 py-24 sm:px-8 lg:py-32">
    <div
      class="mx-auto grid max-w-6xl gap-14 lg:grid-cols-[0.75fr_1.25fr] lg:gap-24"
    >
      <SectionHeading
        eyebrow={m.about_view_eyebrow()}
        title={m.about_view_title()}
      /><div class="space-y-6 text-lg text-ink-soft">
        <p>{m.about_p1()}</p><p>{m.about_p2()}</p><p>{m.about_p3()}</p>
      </div>
    </div>
  </section>
  <section class="bg-powder-light px-5 py-24 sm:px-8 lg:py-32">
    <div
      class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-2 lg:gap-24"
    >
      <Image
        src={founderSeated}
        alt={m.founder_alt()}
        widths={[480, 720, 960]}
        sizes="(min-width:1024px) 42vw,90vw"
        class="aspect-[4/5] w-full object-cover object-top shadow-card"
      /><div>
        <SectionHeading
          eyebrow={m.about_values_eyebrow()}
          title={m.about_values_title()}
        /><div class="mt-10 space-y-8">
          {
            [
              [m.about_client_businesses(), m.about_client_businesses_desc()],
              [
                m.about_client_self_employed(),
                m.about_client_self_employed_desc(),
              ],
              [
                m.about_client_organizations(),
                m.about_client_organizations_desc(),
              ],
            ].map(([title, copy]) => (
              <div class="border-s-2 border-coral ps-6">
                <>
                  <h3 class="font-display text-2xl">{title}</h3>
                  <p class="mt-2 text-ink-soft">{copy}</p>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
  <section class="bg-ink px-5 py-24 sm:px-8 lg:py-28">
    <div class="mx-auto max-w-7xl">
      <div
        class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-end lg:gap-24"
      >
        <SectionHeading
          eyebrow={m.about_locations_eyebrow()}
          title={m.about_locations_title()}
          theme="dark"
        />
        <p class="max-w-2xl text-lg text-powder">
          {m.about_locations_intro()}
        </p>
      </div>
      <div class="mt-14 grid gap-6 sm:grid-cols-2">
        {
          [
            ["01", m.about_branch_ashdod()],
            ["02", m.about_branch_rishon()],
          ].map(([number, city]) => (
            <article class="border border-white/20 bg-white/5 p-8 sm:p-10">
              <p class="text-sm font-bold tracking-[0.2em] text-coral uppercase">
                {number}
              </p>
              <h3 class="mt-5 font-display text-4xl text-white">{city}</h3>
              <p class="mt-3 text-powder">{m.about_branch_label()}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-8 max-w-3xl text-sm text-powder">
        {m.about_locations_note()}
      </p>
    </div>
  </section>
  <CTA locale={locale} title={m.about_cta()} />
</SiteLayout>
