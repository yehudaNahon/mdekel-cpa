---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { SITE } from "../../consts";
import { LOCALES, isLocale } from "../../i18n/config";
import { m } from "../../paraglide/messages.js";
export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang;
if (!isLocale(locale)) return Astro.redirect("/he/");
---

<SiteLayout
  locale={locale}
  title={`${m.nav_contact()} | Myri Dekel CPA`}
  description={m.contact_meta()}
>
  <section class="bg-cream px-5 py-20 sm:px-8 lg:py-28">
    <div class="mx-auto max-w-5xl text-center">
      <p class="text-xs font-bold tracking-[0.26em] text-coral-dark uppercase">
        {m.contact_eyebrow()}
      </p><h1
        class="mt-6 font-display text-6xl leading-none text-balance sm:text-7xl"
      >
        {m.contact_title()}
      </h1><p class="mx-auto mt-8 max-w-2xl text-xl text-ink-soft">
        {m.contact_intro()}
      </p>
    </div>
  </section>
  <section class="px-5 py-24 sm:px-8 lg:py-32">
    <div
      class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-[0.7fr_1.3fr] lg:gap-24"
    >
      <aside>
        <p
          class="text-xs font-bold tracking-[0.22em] text-coral-dark uppercase"
        >
          {m.contact_working()}
        </p><h2 class="mt-5 font-display text-4xl">
          {m.contact_direct()}
        </h2><address class="mt-9 space-y-5 not-italic">
          <div>
            <p class="text-xs font-bold uppercase">{m.label_email()}</p><a
              class="mt-1 inline-block text-xl underline decoration-coral"
              href={`mailto:${SITE.email}`}>{SITE.email}</a
            >
          </div>
        </address>
      </aside>
      <div class="bg-powder-light p-7 sm:p-10 lg:p-14">
        <div
          role="note"
          class="mb-8 border-s-4 border-coral-dark bg-paper p-4 text-sm text-ink-soft"
        >
          <strong class="text-ink">{m.preview_only()}</strong>
          {m.preview_notice()}
        </div><form aria-describedby="form-notice" onsubmit="return false">
          <p id="form-notice" class="sr-only">{m.form_notice()}</p><div
            class="grid gap-6 sm:grid-cols-2"
          >
            <label class="block text-sm font-bold"
              >{m.label_name()} *<input
                required
                name="name"
                autocomplete="name"
                class="mt-2 w-full border border-ink/20 bg-paper px-4 py-3 font-normal"
              /></label
            ><label class="block text-sm font-bold"
              >{m.label_email()} *<input
                required
                type="email"
                name="email"
                autocomplete="email"
                class="mt-2 w-full border border-ink/20 bg-paper px-4 py-3 font-normal"
              /></label
            ><label class="block text-sm font-bold sm:col-span-2"
              >{m.label_topic()}<select
                name="topic"
                class="mt-2 w-full border border-ink/20 bg-paper px-4 py-3 font-normal"
                ><option>{m.topic_accounting()}</option><option
                  >{m.topic_tax()}</option
                ><option>{m.topic_advisory()}</option><option
                  >{m.topic_personal()}</option
                ><option>{m.topic_other()}</option></select
              ></label
            ><label class="block text-sm font-bold sm:col-span-2"
              >{m.label_message()}<textarea
                name="message"
                rows="6"
                class="mt-2 w-full resize-y border border-ink/20 bg-paper px-4 py-3 font-normal"
              ></textarea></label
            >
          </div><button
            type="button"
            class="mt-7 cursor-not-allowed bg-ink/60 px-7 py-4 text-sm font-bold tracking-[0.16em] text-white uppercase"
            disabled>{m.send_inquiry()}</button
          ><p class="mt-3 text-sm text-ink-soft">{m.submission_notice()}</p>
        </form>
      </div>
    </div>
  </section>
</SiteLayout>
