---
import CTA from '../components/CTA.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const services = [
	{
		number: '01',
		title: 'Accounting & reporting',
		description: 'A dependable financial foundation with clean records and reporting that tells you what is really happening.',
		items: ['Monthly bookkeeping oversight', 'Management reporting', 'Year-end preparation', 'Process and record review'],
	},
	{
		number: '02',
		title: 'Tax planning & preparation',
		description: 'Forward-looking tax support that helps you prepare earlier, understand your position, and avoid unnecessary surprises.',
		items: ['Individual and business returns', 'Estimated tax planning', 'Year-round tax strategy', 'Tax notice support'],
	},
	{
		number: '03',
		title: 'Business advisory',
		description: 'Financial perspective for owners making decisions about growth, cash, operations, and the next stage of the business.',
		items: ['Cash-flow planning', 'Budgeting and forecasting', 'Decision support', 'Performance conversations'],
	},
	{
		number: '04',
		title: 'Personal financial guidance',
		description: 'Organized, thoughtful help through financial transitions, competing priorities, and long-term decisions.',
		items: ['Financial organization', 'Life-transition planning', 'Entity and compensation review', 'Coordination with other advisers'],
	},
];
---

<SiteLayout title="Services | M. Dekel CPA" description="Accounting, tax planning, and advisory services designed around clear decisions.">
	<section class="bg-powder px-5 py-20 sm:px-8 lg:py-28">
		<div class="mx-auto max-w-5xl text-center">
			<p class="text-xs font-bold tracking-[0.26em] text-ink-soft uppercase">Services</p>
			<h1 class="mt-6 font-display text-6xl leading-none text-balance text-ink sm:text-7xl">Financial work that leads somewhere.</h1>
			<p class="mx-auto mt-8 max-w-3xl text-xl text-ink-soft">From essential compliance to forward-looking conversations, every engagement is designed to give you a clearer view of what comes next.</p>
		</div>
	</section>
	<div class="mx-auto max-w-7xl px-5 pt-16 sm:px-8 lg:pt-20">
		<img src="/images/financial-desk.jpg" alt="Calculator, notebooks, and organized financial records on a desk" width="1800" height="1200" class="aspect-[16/7] w-full object-cover shadow-soft" />
	</div>

	<section class="px-5 py-24 sm:px-8 lg:py-32">
		<div class="mx-auto max-w-7xl space-y-6">
			{services.map((service, index) => (
				<article class:list={['grid gap-10 p-8 sm:p-12 lg:grid-cols-[0.2fr_0.8fr_0.7fr] lg:gap-16 lg:p-16', index % 2 === 0 ? 'bg-cream' : 'bg-powder-light']}>
					<p class="font-display text-5xl text-coral-dark">{service.number}</p>
					<div>
						<h2 class="font-display text-4xl leading-tight sm:text-5xl">{service.title}</h2>
						<p class="mt-5 text-lg text-ink-soft">{service.description}</p>
					</div>
					<ul class="space-y-3 border-t border-ink/15 pt-6 lg:border-s lg:border-t-0 lg:ps-10 lg:pt-0">
						{service.items.map((item) => <li class="flex gap-3"><span class="text-coral-dark" aria-hidden="true">&mdash;</span>{item}</li>)}
					</ul>
				</article>
			))}
		</div>
	</section>

	<section class="bg-ink px-5 py-24 sm:px-8 lg:py-28">
		<div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
			<SectionHeading eyebrow="What to expect" title="A service shaped around the way you work." theme="dark" />
			<div class="grid gap-8 sm:grid-cols-2">
				{[
					['A clear scope', 'We agree on priorities, responsibilities, timing, and what success looks like.'],
					['Plain-language advice', 'Technical details are translated into direct, useful recommendations.'],
					['A steady rhythm', 'Communication and deliverables follow a dependable cadence.'],
					['Room to adapt', 'As your circumstances change, the work can evolve with them.'],
				].map(([title, copy]) => (
					<div class="border-t border-white/20 pt-6">
						<h3 class="font-display text-2xl text-white">{title}</h3>
						<p class="mt-3 text-powder">{copy}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<CTA />
</SiteLayout>
