---
import { Image } from 'astro:assets';
import founderPortrait from '../assets/headshots/m-dekel-portrait.jpg';
import founderSeated from '../assets/headshots/m-dekel-seated.jpg';
import CTA from '../components/CTA.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="About | M. Dekel CPA" description="A relationship-led accounting practice offering thoughtful, clear financial guidance.">
	<section class="bg-cream px-5 py-20 sm:px-8 lg:py-28">
		<div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-2 lg:gap-24">
			<div>
				<p class="text-xs font-bold tracking-[0.26em] text-coral-dark uppercase">About the practice</p>
				<h1 class="mt-6 font-display text-6xl leading-none text-balance sm:text-7xl">Numbers matter. So does the story behind them.</h1>
				<p class="mt-8 max-w-xl text-xl text-ink-soft">M. Dekel CPA pairs technical care with genuine attention, helping clients feel informed and supported through every financial chapter.</p>
			</div>
			<div class="relative mx-auto max-w-lg">
				<div class="absolute -end-8 -top-8 h-2/3 w-2/3 bg-powder"></div>
				<Image src={founderPortrait} alt="M. Dekel, founder of M. Dekel CPA" widths={[480, 720, 960]} sizes="(min-width: 1024px) 40vw, 80vw" class="relative aspect-[4/5] w-full object-cover shadow-soft" />
			</div>
		</div>
	</section>

	<section class="px-5 py-24 sm:px-8 lg:py-32">
		<div class="mx-auto grid max-w-6xl gap-14 lg:grid-cols-[0.75fr_1.25fr] lg:gap-24">
			<SectionHeading eyebrow="Our point of view" title="Accounting should make life feel less complicated." />
			<div class="space-y-6 text-lg text-ink-soft">
				<p>Financial decisions rarely happen in isolation. They are connected to the business you are building, the people you support, and the future you are working toward.</p>
				<p>That is why our process starts with listening. We bring structure to the details, explain the implications in everyday language, and stay close enough to help as circumstances change.</p>
				<p>This page contains working brand copy. Replace it with the founder's verified biography, credentials, and professional experience before public launch.</p>
			</div>
		</div>
	</section>

	<section class="bg-powder-light px-5 py-24 sm:px-8 lg:py-32">
		<div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-2 lg:gap-24">
			<Image src={founderSeated} alt="M. Dekel in an outdoor portrait" widths={[480, 720, 960]} sizes="(min-width: 1024px) 42vw, 90vw" class="aspect-[4/5] w-full object-cover object-top shadow-card" />
			<div>
				<SectionHeading eyebrow="What guides us" title="Professional care, made personal." />
				<div class="mt-10 space-y-8">
					{[
						['Clarity', 'Straightforward explanations and advice you can actually use.'],
						['Care', 'Attentive service grounded in your real priorities and circumstances.'],
						['Consistency', 'Dependable processes, thoughtful follow-through, and no avoidable surprises.'],
					].map(([title, copy]) => (
						<div class="border-s-2 border-coral ps-6">
							<h3 class="font-display text-2xl">{title}</h3>
							<p class="mt-2 text-ink-soft">{copy}</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<CTA title="Bring us the questions behind the numbers." />
</SiteLayout>
