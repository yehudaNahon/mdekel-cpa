---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import founderCutout from '../assets/headshots/m-dekel-cutout.png';
import founderPortrait from '../assets/headshots/m-dekel-portrait.jpg';
import ArticleCard from '../components/ArticleCard.astro';
import CTA from '../components/CTA.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<SiteLayout>
	<section class="relative overflow-hidden bg-cream">
		<div class="mx-auto grid min-h-[760px] max-w-7xl items-center gap-12 px-5 py-20 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:py-28">
			<div class="relative z-10 max-w-2xl">
				<p class="text-xs font-bold tracking-[0.26em] text-coral-dark uppercase">Accounting with perspective</p>
				<h1 class="mt-6 font-display text-6xl leading-[0.98] text-balance text-ink sm:text-7xl lg:text-[6.2rem]">Your numbers should help you move forward.</h1>
				<p class="mt-8 max-w-xl text-xl leading-relaxed text-ink-soft">Calm, attentive accounting and advisory support for business owners and individuals navigating important financial decisions.</p>
				<div class="mt-10 flex flex-wrap gap-4">
					<a href="/contact/" class="bg-ink px-7 py-4 text-sm font-bold tracking-[0.16em] text-white uppercase transition hover:bg-coral-dark">Book a consultation</a>
					<a href="/services/" class="border border-ink px-7 py-4 text-sm font-bold tracking-[0.16em] text-ink uppercase transition hover:bg-white">View services</a>
				</div>
			</div>

			<div class="relative mx-auto w-full max-w-lg lg:ms-auto">
				<div class="absolute start-0 top-12 h-[82%] w-[88%] bg-powder sm:-start-10"></div>
				<div class="absolute end-0 -bottom-8 size-44 rounded-full border-[28px] border-blush sm:-end-8"></div>
				<Image src={founderPortrait} alt="Founder of M. Dekel CPA" widths={[480, 720, 960]} sizes="(min-width: 1024px) 42vw, 80vw" loading="eager" class="relative z-10 aspect-[4/5] w-full object-cover object-center shadow-soft" />
				<div class="absolute start-0 -bottom-8 z-20 max-w-56 bg-paper p-5 shadow-card sm:-start-14 sm:p-6">
					<p class="font-display text-2xl leading-tight">Thoughtful guidance.<br />Clear next steps.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-powder px-5 py-16 text-center sm:px-8 lg:py-20">
		<p class="mx-auto max-w-4xl font-display text-3xl leading-snug text-ink sm:text-4xl">Financial clarity is not just about getting the numbers right. It is about understanding what they make possible.</p>
	</section>

	<section class="px-5 py-24 sm:px-8 lg:py-32">
		<div class="mx-auto max-w-7xl">
			<div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
				<SectionHeading eyebrow="How we can help" title="Practical support for every stage of growth." description="A relationship-led approach to the essential financial work behind strong decisions." />
				<a href="/services/" class="shrink-0 text-sm font-bold tracking-[0.16em] text-ink uppercase underline decoration-coral decoration-2 underline-offset-8">View all services</a>
			</div>
			<div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
				<ServiceCard number="01" title="Accounting" description="Reliable reporting and organized records that keep your business grounded." />
				<ServiceCard number="02" title="Tax planning" description="Proactive preparation designed to reduce surprises and create confidence." />
				<ServiceCard number="03" title="Business advisory" description="A clearer view of cash flow, priorities, and the choices ahead." />
				<ServiceCard number="04" title="Personal finance" description="Careful guidance through financial transitions and long-term planning." />
			</div>
		</div>
	</section>

	<section class="overflow-hidden bg-blush px-5 py-24 sm:px-8 lg:py-32">
		<div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24">
			<div class="relative mx-auto min-h-[480px] w-full max-w-md">
				<div class="absolute inset-x-4 bottom-0 h-[82%] rounded-t-full bg-powder"></div>
				<Image src={founderCutout} alt="M. Dekel, founder and CPA" class="absolute inset-x-0 bottom-0 z-10 mx-auto w-[92%]" />
			</div>
			<div>
				<SectionHeading eyebrow="Meet your accountant" title="Expertise that starts with listening." description="M. Dekel CPA is a relationship-driven practice built around a simple idea: good financial advice should feel understandable, relevant, and personal." />
				<p class="mt-6 text-ink-soft">We take time to understand the whole picture, translate complexity into plain language, and help clients move ahead with purpose.</p>
				<a href="/about/" class="mt-9 inline-flex bg-ink px-7 py-4 text-sm font-bold tracking-[0.16em] text-white uppercase transition hover:bg-coral-dark">More about the practice</a>
			</div>
		</div>
	</section>

	<section class="px-5 py-24 sm:px-8 lg:py-32">
		<div class="mx-auto max-w-7xl">
			<SectionHeading eyebrow="A calm process" title="Clear from the first conversation." align="center" />
			<ol class="mt-16 grid gap-10 md:grid-cols-3">
				{[
					['01', 'Listen', 'We begin with your goals, questions, and the context behind the numbers.'],
					['02', 'Make sense of it', 'We organize the details, identify priorities, and explain what matters.'],
					['03', 'Move forward', 'You leave with practical next steps and ongoing support when you need it.'],
				].map(([number, title, copy]) => (
					<li class="border-t border-ink/20 pt-7">
						<span class="text-xs font-bold tracking-[0.2em] text-coral-dark">{number}</span>
						<h3 class="mt-5 font-display text-3xl">{title}</h3>
						<p class="mt-4 text-ink-soft">{copy}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="bg-cream px-5 py-24 sm:px-8 lg:py-32">
		<div class="mx-auto max-w-7xl">
			<SectionHeading eyebrow="From the journal" title="Fresh perspective for your finances." description="Practical ideas to help you understand the numbers and make more confident decisions." />
			<div class="mt-14 grid gap-10 md:grid-cols-3">
				{posts.map((post) => <ArticleCard post={post} />)}
			</div>
		</div>
	</section>

	<CTA />
</SiteLayout>
