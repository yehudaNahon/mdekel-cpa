---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & { active?: boolean };

const { href, class: className, active, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const isLocaleHome = /^\/(?:he|en|fr)\/$/.test(String(href));
const normalizedPath = pathname.replace(/\/$/, "");
const normalizedHref = String(href).replace(/\/$/, "");
const isActive =
  active ??
  (isLocaleHome
    ? normalizedPath === normalizedHref
    : normalizedPath.startsWith(normalizedHref));
---

<a
  href={href}
  aria-current={isActive ? "page" : undefined}
  class:list={[
    "inline-flex items-center border-b-2 px-1 py-2 text-sm tracking-[0.12em] uppercase transition-colors",
    isActive
      ? "border-coral-dark text-ink"
      : "border-transparent text-ink-soft hover:border-powder hover:text-ink",
    className,
  ]}
  {...props}
>
  <slot />
</a>
