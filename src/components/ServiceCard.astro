---
interface Props {
  number?: string;
  title: string;
  description: string;
  href?: string;
  linkLabel: string;
}
const {
  number,
  title,
  description,
  href = "/services/",
  linkLabel,
} = Astro.props;
---

<article
  class="group border border-ink/10 bg-paper p-7 transition duration-300 hover:-translate-y-1 hover:shadow-card sm:p-8"
>
  <div class="flex items-start justify-between gap-6">
    {number && <span class="font-display text-4xl text-powder">{number}</span>}
  </div>
  <h3 class="mt-8 font-display text-2xl text-ink">{title}</h3>
  <p class="mt-4 text-ink-soft">{description}</p>
  <a
    href={href}
    class="mt-6 inline-flex text-sm font-bold tracking-[0.16em] text-ink uppercase underline decoration-coral decoration-2 underline-offset-8"
    >{linkLabel}<span class="sr-only">: {title}</span></a
  >
</article>
