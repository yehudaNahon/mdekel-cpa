---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import { localePath, postSlug, type Locale } from "../i18n/config";
import { m } from "../paraglide/messages.js";

interface Props {
  post: CollectionEntry<"articles">;
  locale: Locale;
}
const { post, locale } = Astro.props;
const href = localePath(`/articles/${postSlug(post.id)}/`, locale);
---

<article class="group">
  <a href={href} class="block overflow-hidden bg-powder-light">
    {
      post.data.heroImage ? (
        <img
          src={post.data.heroImage}
          alt={post.data.title}
          width="720"
          height="402"
          loading="lazy"
          class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="aspect-[16/9] w-full bg-powder" />
      )
    }
  </a>
  <div class="pt-6">
    <p class="text-xs font-bold tracking-[0.2em] text-coral-dark uppercase">
      <FormattedDate date={post.data.pubDate} locale={locale} />
    </p>
    <h2 class="mt-3 font-display text-3xl leading-tight text-ink">
      <a
        href={href}
        class="decoration-coral underline-offset-8 group-hover:underline"
        >{post.data.title}</a
      >
    </h2>
    <p class="mt-4 text-ink-soft">{post.data.description}</p>
    <a
      href={href}
      class="mt-6 inline-flex text-sm font-bold tracking-[0.16em] text-ink uppercase"
      >{m.read_article()}
      <span
        aria-hidden="true"
        class="ms-3 transition group-hover:translate-x-1 rtl:group-hover:-translate-x-1"
        >&rarr;</span
      ></a
    >
  </div>
</article>
