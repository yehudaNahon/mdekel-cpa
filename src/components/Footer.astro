---
import { NAV_ITEMS, SITE } from '../consts';
const today = new Date();
---

<footer class="bg-ink text-white">
	<div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[1.4fr_1fr_1fr] lg:py-20">
		<div>
			<a href="/" class="font-display text-3xl tracking-[0.08em]">M. DEKEL</a>
			<p class="mt-5 max-w-md text-powder">{SITE.tagline} Thoughtful support for the numbers behind your life and business.</p>
			<p class="mt-8 text-xs tracking-[0.18em] text-powder/70 uppercase">Working business details — replace before launch</p>
		</div>
		<div>
			<h2 class="text-xs font-bold tracking-[0.2em] text-coral uppercase">Explore</h2>
			<ul class="mt-5 space-y-3">
				{NAV_ITEMS.map((item) => <li><a href={item.href} class="text-powder transition hover:text-white">{item.label}</a></li>)}
			</ul>
		</div>
		<div>
			<h2 class="text-xs font-bold tracking-[0.2em] text-coral uppercase">Contact</h2>
			<address class="mt-5 space-y-3 text-powder not-italic">
				<p>{SITE.address}</p>
				<p><a href={`mailto:${SITE.email}`} class="hover:text-white">{SITE.email}</a></p>
				<p><a href={`tel:${SITE.phone.replace(/[^+\d]/g, '')}`} class="hover:text-white">{SITE.phone}</a></p>
			</address>
		</div>
	</div>
	<div class="border-t border-white/10 px-5 py-6 text-center text-sm text-powder/70 sm:px-8">
		&copy; {today.getFullYear()} {SITE.name}. All rights reserved.
	</div>
</footer>
