---
import { SITE } from "../consts";
import { localePath, type Locale } from "../i18n/config";
import { m } from "../paraglide/messages.js";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const today = new Date();
const navItems = [
  ["/", m.nav_home()],
  ["/about/", m.nav_about()],
  ["/services/", m.nav_services()],
  ["/calculators/", m.nav_calculators()],
  ["/articles/", m.nav_articles()],
  ["/contact/", m.nav_contact()],
] as const;
---

<footer class="bg-ink text-white">
  <div
    class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[1.4fr_1fr_1fr] lg:py-20"
  >
    <div>
      <a
        href={localePath("/", locale)}
        class="inline-flex bg-paper px-4 py-3"
        aria-label={`${m.brand_name()} ${m.nav_home()}`}
      >
        <img
          src="/images/myri-dekel-logo.png"
          alt=""
          width="390"
          height="310"
          class="h-32 w-auto"
        />
      </a>
      <p class="mt-5 max-w-md text-powder">
        {m.site_tagline()}
        {m.footer_copy()}
      </p><p class="mt-8 text-xs tracking-[0.18em] text-powder/70 uppercase">
        {m.footer_placeholder()}
      </p>
    </div>
    <div>
      <h2 class="text-xs font-bold tracking-[0.2em] text-coral uppercase">
        {m.footer_explore()}
      </h2><ul class="mt-5 space-y-3">
        {
          navItems.map(([href, label]) => (
            <li>
              <a
                href={localePath(href, locale)}
                class="text-powder transition hover:text-white"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="text-xs font-bold tracking-[0.2em] text-coral uppercase">
        {m.footer_contact()}
      </h2><address class="mt-5 space-y-3 text-powder not-italic">
        <p>
          <a href={`mailto:${SITE.email}`} class="hover:text-white"
            >{SITE.email}</a
          >
        </p>
      </address>
    </div>
  </div>
  <div
    class="border-t border-white/10 px-5 py-6 text-center text-sm text-powder/70"
  >
    &copy; {today.getFullYear()}
    {m.brand_name()}. {m.footer_rights()}
  </div>
</footer>
