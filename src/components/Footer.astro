---
import { SITE, whatsappHref } from "../consts";
import { localePath, type Locale } from "../i18n/config";
import { m } from "../paraglide/messages.js";
import WhatsAppIcon from "./WhatsAppIcon.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const today = new Date();
const contactHref = whatsappHref(m.whatsapp_message({}, { locale }));
const navItems: Array<{ href: string; label: string; isContact?: boolean }> = [
  { href: localePath("/", locale), label: m.nav_home() },
  { href: localePath("/about/", locale), label: m.nav_about() },
  { href: localePath("/services/", locale), label: m.nav_services() },
  { href: localePath("/calculators/", locale), label: m.nav_calculators() },
  { href: localePath("/articles/", locale), label: m.nav_articles() },
];
---

<footer class="bg-ink text-white">
  <div
    class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[1.4fr_1fr_1fr] lg:py-20"
  >
    <div>
      <a
        href={localePath("/", locale)}
        class="inline-flex bg-paper px-4 py-3"
        aria-label={`${m.brand_name()} ${m.nav_home()}`}
      >
        <img
          src="/images/myri-dekel-logo.png"
          alt=""
          width="390"
          height="310"
          class="h-32 w-auto"
        />
      </a>
      <p class="mt-5 max-w-md text-powder">
        {m.site_tagline()}
        {m.footer_copy()}
      </p>
    </div>
    <div>
      <h2 class="text-xs font-bold tracking-[0.2em] text-coral uppercase">
        {m.footer_explore()}
      </h2><ul class="mt-5 space-y-3">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.isContact ? "_blank" : undefined}
                rel={item.isContact ? "noopener noreferrer" : undefined}
                aria-label={
                  item.isContact ? m.whatsapp_link_label() : undefined
                }
                class="inline-flex items-center gap-2 text-powder transition hover:text-white"
              >
                {item.isContact && <WhatsAppIcon class="size-4" />}
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="text-xs font-bold tracking-[0.2em] text-coral uppercase">
        {m.footer_contact()}
      </h2><address class="mt-5 space-y-3 text-powder not-italic">
        <div>
          <p class="text-xs font-bold uppercase">{m.label_phone()}</p>
          <a
            href={contactHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={m.whatsapp_link_label()}
            class="mt-1 inline-flex items-center gap-2 hover:text-white"
          >
            <WhatsAppIcon />
            <bdi>{SITE.whatsappDisplay}</bdi>
          </a>
        </div>
        <div>
          <p class="text-xs font-bold uppercase">{m.label_email()}</p>
          <a
            href={`mailto:${SITE.email}`}
            class="mt-1 inline-block hover:text-white">{SITE.email}</a
          >
        </div>
      </address>
    </div>
  </div>
  <div
    class="border-t border-white/10 px-5 py-6 text-center text-sm text-powder/70"
  >
    &copy; {today.getFullYear()}
    {m.brand_name()}. {m.footer_rights()}
  </div>
</footer>
