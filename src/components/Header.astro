---
import HeaderLink from './HeaderLink.astro';
import { NAV_ITEMS, SITE } from '../consts';
---

<header class="sticky top-0 z-40 border-b border-ink/8 bg-paper/95 backdrop-blur-md">
	<nav class="mx-auto flex min-h-20 max-w-7xl items-center justify-between gap-2 px-5 sm:gap-6 sm:px-8" aria-label="Primary navigation">
		<a href="/" class="group shrink-0 leading-none text-ink no-underline" aria-label={`${SITE.name} home`}>
			<span class="block font-display text-2xl tracking-[0.08em] sm:text-3xl">M. DEKEL</span>
			<span class="mt-1 hidden text-[0.6rem] tracking-[0.42em] text-ink-soft uppercase min-[430px]:block">Certified Public Accountant</span>
		</a>

		<div class="hidden items-center gap-5 lg:flex">
			{NAV_ITEMS.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
		</div>

		<a href={SITE.consultationHref} class="hidden bg-coral px-5 py-3 text-sm font-bold tracking-wider text-ink uppercase transition hover:bg-coral-dark hover:text-white sm:inline-flex">
			Let's talk
		</a>

		<details class="relative lg:hidden">
			<summary class="flex cursor-pointer list-none items-center gap-1 border border-ink/15 px-3 py-2 text-sm tracking-wider uppercase marker:hidden sm:gap-2 sm:px-4">
				Menu
				<svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
			</summary>
			<div class="absolute end-0 top-[calc(100%+0.75rem)] flex w-56 flex-col border border-ink/10 bg-paper p-4 shadow-card">
				{NAV_ITEMS.map((item) => <HeaderLink href={item.href} class="w-full">{item.label}</HeaderLink>)}
			</div>
		</details>
	</nav>
</header>
