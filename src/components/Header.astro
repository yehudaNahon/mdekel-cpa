---
import HeaderLink from "./HeaderLink.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { SITE } from "../consts";
import { localePath, type Locale } from "../i18n/config";
import { m } from "../paraglide/messages.js";
interface Props {
  locale: Locale;
  canonicalPath: string;
}
const { locale, canonicalPath } = Astro.props;
const navItems = [
  { href: "/", label: m.nav_home() },
  { href: "/about/", label: m.nav_about() },
  { href: "/services/", label: m.nav_services() },
  { href: "/calculators/", label: m.nav_calculators() },
  { href: "/articles/", label: m.nav_articles() },
  { href: "/contact/", label: m.nav_contact() },
];
const navIsActive = (href: string) =>
  href === "/" ? canonicalPath === "/" : canonicalPath.startsWith(href);
---

<header
  class="sticky top-0 z-40 border-b border-ink/8 bg-paper/95 backdrop-blur-md"
>
  <nav
    class="mx-auto flex min-h-20 max-w-7xl items-center justify-between gap-2 px-5 sm:gap-4 sm:px-8"
    aria-label={m.nav_primary()}
  >
    <a
      href={localePath("/", locale)}
      class="group shrink-0 leading-none text-ink no-underline"
      aria-label={`${m.brand_name()} ${m.nav_home()}`}
    >
      <span class="block font-display text-2xl tracking-[0.08em] sm:text-3xl"
        >{m.brand_name()}</span
      >
      <span
        class="mt-1 hidden text-[0.6rem] tracking-[0.32em] text-ink-soft uppercase min-[520px]:block"
        >{m.professional_title()}</span
      >
    </a>
    <div class="hidden items-center gap-4 lg:flex">
      {
        navItems.map((item) => (
          <HeaderLink
            href={localePath(item.href, locale)}
            active={navIsActive(item.href)}
          >
            {item.label}
          </HeaderLink>
        ))
      }
    </div>
    <div class="flex shrink-0 items-center gap-2 lg:gap-4">
      <LanguageSwitcher locale={locale} canonicalPath={canonicalPath} />
      <a
        href={localePath(SITE.consultationHref, locale)}
        class="hidden bg-coral px-5 py-3 text-sm font-bold tracking-wider text-ink uppercase transition hover:bg-coral-dark hover:text-white lg:inline-flex"
        >{m.nav_talk()}</a
      >
      <details class="relative lg:hidden">
        <summary
          class="flex cursor-pointer list-none items-center gap-1 border border-ink/15 px-3 py-2 text-sm tracking-wider uppercase marker:hidden"
          aria-label={m.nav_menu()}
          ><span class="hidden min-[480px]:inline">{m.nav_menu()}</span><svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="size-4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
          ></summary
        >
        <div
          class="absolute end-0 top-[calc(100%+0.75rem)] flex w-64 flex-col border border-ink/10 bg-paper p-4 shadow-card"
        >
          {
            navItems.map((item) => (
              <HeaderLink
                href={localePath(item.href, locale)}
                active={navIsActive(item.href)}
                class="w-full"
              >
                {item.label}
              </HeaderLink>
            ))
          }
        </div>
      </details>
    </div>
  </nav>
</header>
